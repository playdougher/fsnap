#!/bin/bash
# fsnap - A lightweight file state snapshot tool
# Source: https://github.com/playdougher/fsnap

ST_ROOT="/home/zhihao/Downloads/.teststates"
INDEX="$ST_ROOT/index.log"
mkdir -p "$ST_ROOT"

case $1 in
    s|save)
        DESC="${2:?Missing description}"
        TARGET="${3:?Missing path}"
        ABS_TARGET="$(realpath "$TARGET")"
        ID="$(date +%Y%m%d_%H%M%S)"
        DEST="$ST_ROOT/$ID"
        mkdir -p "$DEST"
        echo "$DESC" > "$DEST/desc.txt"
        printf "%s | %s | %s\n" "$ID" "$ABS_TARGET" "${DESC//$'\n'/ }" >> "$INDEX"
        rsync -aR "$ABS_TARGET" "$DEST/" && echo "Snapshot saved: $ID"
        ;;

    r|restore)
        ID="${2:?Missing ID}"
        SNAP="$ST_ROOT/$ID"
        if [ ! -d "$SNAP" ]; then echo "Error: Snapshot $ID not found."; exit 1; fi
        rsync -Orlt --exclude="desc.txt" --out-format="%n" "$SNAP/" / | sed '/\/$/d'
        ;;

    v|view)
        ID="${2:?Missing ID}"
        SNAP="$ST_ROOT/$ID"
        if [ ! -d "$SNAP" ]; then echo "Error: Snapshot $ID not found."; exit 1; fi
        echo "id: $ID"
        echo -n "description: "
        cat "$SNAP/desc.txt" 2>/dev/null || echo "(No description)"
        echo -n "size: "; du -sh "$SNAP" | cut -f1
        echo -n "files: "
        (cd "$SNAP" && find . -type f ! -name "desc.txt" | sed 's|^\./||' | tr '\n' ' ')
        echo
        ;;

    l|list)
        if [ -f "$INDEX" ]; then
            sort -r "$INDEX"
        else
            echo "No index found. Listing directory names:"
            ls -1 "$ST_ROOT" | grep -v "index.log" | sort -r
        fi
        ;;

    d|delete)
        ID="${2:?Missing ID}"
        FORCE="$3"
        SNAP="$ST_ROOT/$ID"
        if [ -f "$INDEX" ]; then ENTRY=$(grep "^$ID" "$INDEX"); fi
        if [ "$FORCE" != "-f" ]; then
            if [ -n "$ENTRY" ]; then
                echo "Found entry:"
                echo "$ENTRY"
                echo "--------------------------------------------------------------------------------"
            fi
            read -p "Are you sure you want to delete snapshot $ID? (y/N): " confirm
            if [[ ! "$confirm" =~ ^[yY]$ ]]; then
                echo "Operation cancelled."
                exit 0
            fi
        fi
        [ -d "$SNAP" ] && rm -rf "$SNAP" && echo "Directory $ID removed."
        if [ -f "$INDEX" ]; then
            grep -v "^$ID |" "$INDEX" > "$INDEX.tmp" && mv "$INDEX.tmp" "$INDEX"
            echo "Index entry $ID removed."
        fi
        ;;

    help|'?'|"")
        echo "fsnap - A lightweight file state snapshot tool for developers and AI agents."
        echo "Source: https://github.com/playdougher/fsnap"
        echo
        echo "USAGE:"
        echo "  $0 <command> [arguments...]"
        echo
        echo "COMMANDS:"
        echo "  s [desc] [path]    Save a snapshot."
        echo "  v [ID]             View snapshot details."
        echo "  r [ID]             Restore a snapshot."
        echo "  l                  List all snapshots."
        echo "  d [ID] [-f]        Delete a snapshot (-f to skip confirmation)."
        echo "  help (or ?)        Show this help message."
        echo
        echo "EXAMPLES:"
        echo "  $0 s \"pre-refactor\" src/core.c"
        echo "  $0 v 20260428_120000"
        echo "  $0 r 20260428_120000"
        echo "  $0 l"
        echo "  $0 l | grep refactor"
        ;;
    
    *)
        echo "Unknown command: $1"
        echo "Use '$0 help' for usage instructions."
        exit 1
        ;;
esac
